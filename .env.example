# Copy to .env.local and fill in. Never commit real values.
# Every variable here is server-only. Do NOT prefix secrets with NEXT_PUBLIC_.

# ---- Database (PostgreSQL, EU region, TLS required) ----
# Leave empty to use the embedded local database in data/derived/ (development only).
# Hosted: postgresql://user:password@host/db?sslmode=verify-full
DATABASE_URL=

# ---- Field-level encryption (see docs/security.md) ----
# 32 random bytes, base64. Generate each with:  openssl rand -base64 32
# The keys must be different, and must never be stored in the database.
# Changing them makes already-ingested data unreadable: re-run the ingestion.
DATA_ENCRYPTION_KEY=
DATA_ENCRYPTION_KEY_ID=k1
BLIND_INDEX_KEY=

# ---- Sessions ----
SESSION_SECRET=

# ---- AI coach ----
# With AI off, or with no key, the coach still answers in basic mode.
AI_PROCESSING_ALLOWED=false
# openai | gemini
AI_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_MODEL=
GEMINI_API_KEY=
GEMINI_MODEL=
CHAT_TIMEOUT_MS=20000
CHAT_MAX_TOOL_STEPS=4

# ---- Voice (ElevenLabs) ----
# Key permissions needed: Text to Speech, Speech to Text, Voices (read), and ElevenAgents
# (write) for realtime calls. Create the agent with `pnpm voice:setup` and paste its id below.
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
ELEVENLABS_AGENT_ID=

# ---- Device notifications (Web Push) ----
# Generate both with:  npx web-push generate-vapid-keys
# Leave empty to switch device notifications off.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# ---- Demo ----
DEMO_MODE=true
DEMO_AS_OF_DATE=2026-09-15
# Shared password for the synthetic demo customers. Shown on the sign-in page in demo mode.
DEMO_LOGIN_PASSWORD=
# Password for the admin dashboard at /admin (aggregate statistics only).
ADMIN_PASSWORD=
APP_BASE_URL=http://localhost:3000
