# Copy to .env.local and fill in. Never commit real values.
# Every variable here is server-only. Do NOT prefix secrets with NEXT_PUBLIC_.

# ---- Database (PostgreSQL, EU region, TLS required) ----
# Always connect with sslmode=verify-full.
DATABASE_URL=

# ---- Field-level encryption (see docs/security.md) ----
# 32 random bytes, base64. Generate each with:  openssl rand -base64 32
# These two keys must be different, and must never be stored in the database.
DATA_ENCRYPTION_KEY=
DATA_ENCRYPTION_KEY_ID=k1
BLIND_INDEX_KEY=

# ---- Sessions ----
SESSION_SECRET=

# ---- AI (off until the bank confirms data may leave the app) ----
AI_PROCESSING_ALLOWED=false
AI_PROVIDER=
AI_MODEL=
AI_API_KEY=
CHAT_TIMEOUT_MS=20000
CHAT_MAX_TOOL_STEPS=4

# ---- Demo ----
DEMO_MODE=true
DEMO_AS_OF_DATE=2026-09-15
APP_BASE_URL=http://localhost:3000
